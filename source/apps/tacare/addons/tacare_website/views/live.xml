<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="live_layout" name="TA.CARE live layout">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <div id="wrap" t-att-class="'tc-live tc-%s' % site">
        <a class="tc-skip" href="#tc-main">Đến nội dung chính</a>
        <div class="tc-demo-note"><div class="tc-container tc-demo-inner"><span>TA.CARE · BẢN DEV LOCAL</span><span>Dữ liệu đang lưu trong Odoo <strong>tacare_local</strong></span></div></div>
        <header class="tc-header">
          <div class="tc-container tc-header-inner">
            <a t-att-href="urls[site]" class="tc-brand">
              <img t-att-src="'/tacare_website/static/src/img/%s.png' % site" t-att-alt="'Logo ' + site"/>
              <span><strong t-esc="{'khovieclam':'Kho Việc Làm','tuhoso':'Tủ Hồ Sơ','tacare':'TA.CARE'}[site]"/><small t-esc="{'khovieclam':'khovieclam.vn','tuhoso':'tuhoso.com','tacare':'tacare.vn'}[site]"/></span>
            </a>
            <nav aria-label="Điều hướng chính" class="tc-nav">
              <t t-if="site == 'khovieclam'">
                <a t-att-href="urls['khovieclam']">Trang chủ</a><a href="/kvl/jobs">Cơ hội</a>
                <a t-if="role in ('business','admin')" href="/kvl/manage">Quản lý tin</a>
                <a t-if="role in ('business','admin')" href="/tacare/matching">Hồ sơ phù hợp</a>
              </t>
              <t t-elif="site == 'tuhoso'">
                <a t-att-href="urls['tuhoso']">Trang chủ</a><a t-if="role == 'candidate'" href="/tuhoso/me">Hồ sơ của tôi</a>
                <a href="/kvl/jobs">Tìm cơ hội</a>
              </t>
              <t t-else="">
                <a t-att-href="urls['tacare']">Hệ sinh thái</a>
                <a t-if="not is_guest" href="/tacare/matching">Phù hợp</a>
                <a t-if="not is_guest" href="/tacare/connections">Kết nối</a>
                <a t-if="not is_guest" href="/tacare/notifications">Thông báo</a>
              </t>
            </nav>
            <div class="tc-header-actions">
              <nav class="tc-site-switch" aria-label="Chuyển website">
                <a t-att-href="urls['khovieclam']" t-att-class="'is-current' if site == 'khovieclam' else ''">Kho Việc Làm</a>
                <a t-att-href="urls['tuhoso']" t-att-class="'is-current' if site == 'tuhoso' else ''">Tủ Hồ Sơ</a>
                <a t-att-href="urls['tacare']" t-att-class="'is-current' if site == 'tacare' else ''">TA.CARE</a>
              </nav>
              <a t-if="is_guest" class="tc-button tc-outline" t-att-href="'/web/login?redirect=%s' % request.httprequest.path">Đăng nhập</a>
              <t t-else=""><span class="tc-account" t-esc="account_name"/><a class="tc-small-link" href="/web/session/logout?redirect=/">Đăng xuất</a></t>
            </div>
          </div>
        </header>
        <main id="tc-main" class="tc-container" tabindex="-1">
          <div t-if="notice" class="tc-alert" role="status">Đã cập nhật dữ liệu thành công.</div>
          <t t-out="0"/>
        </main>
        <footer class="tc-footer"><div class="tc-container">TA.CARE · Website Odoo local. Nội dung công khai có thể xem; thao tác ghi dữ liệu yêu cầu đăng nhập và đúng vai trò.</div></footer>
      </div>
    </t>
  </template>
  <template id="live_profile" name="Tủ Hồ Sơ - Hồ sơ">
    <t t-call="tacare_website.live_layout">
      <p class="tc-breadcrumb"><a href="/">Tủ Hồ Sơ</a> / <span t-esc="'Hồ sơ của tôi' if edit else profile.name"/></p>
      <div class="tc-page-head"><p class="tc-eyebrow">HỒ SƠ NĂNG LỰC</p><h1 t-esc="profile.name"/><p t-esc="profile.headline or 'Hành trình năng lực đang được cập nhật'"/></div>
      <div t-if="error" class="tc-error" role="alert" t-esc="error"/>
      <div class="tc-detail-grid"><div class="tc-stack">
        <section class="tc-card"><h2>Giới thiệu</h2><p><strong>Học vấn:</strong> <span t-esc="profile.education or 'Chưa cập nhật'"/></p><p><strong>Lĩnh vực:</strong> <span t-esc="dict(sectors).get(profile.sector, 'Chưa cập nhật')"/></p><p><strong>Địa điểm:</strong> <span t-esc="profile.location or 'Chưa cập nhật'"/></p><p><strong>Định hướng:</strong> <span t-esc="profile.goal or 'Chưa cập nhật'"/></p><p><strong>Hình thức:</strong> <span t-esc="dict(modes).get(profile.mode, 'Chưa cập nhật')"/></p><p><strong>Sẵn sàng:</strong> <span t-esc="profile.availability or 'Chưa cập nhật'"/></p></section>
        <section class="tc-card"><h2>Kỹ năng</h2><div class="tc-list"><article t-foreach="profile.skill_ids" t-as="skill"><strong t-esc="skill.name"/><span t-esc="dict(skill._fields['level'].selection).get(skill.level)"/><p t-esc="skill.use or ''"/><details t-if="edit"><summary>Sửa kỹ năng</summary><form t-att-action="'/tuhoso/skill/%s/save' % skill.id" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Tên kỹ năng<input name="name" required="required" t-att-value="skill.name"/></label><label>Mức độ<select name="level"><option t-foreach="skill._fields['level'].selection" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if skill.level == opt[0] else None" t-esc="opt[1]"/></select></label><label>Đã dùng vào việc gì?<input name="use" t-att-value="skill.use or ''"/></label><button class="tc-button" type="submit">Lưu kỹ năng</button></form><form t-att-action="'/tuhoso/skill/%s/delete' % skill.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="tc-button tc-outline" type="submit">Xóa kỹ năng</button></form></details></article></div><p t-if="not profile.skill_ids" class="tc-empty">Chưa có kỹ năng nào.</p><form t-if="edit" action="/tuhoso/skill/add" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Tên kỹ năng<input name="name" required="required"/></label><label>Mức độ<select name="level"><option value="learning">Mới học</option><option value="basic">Cơ bản</option><option value="good">Khá</option><option value="advanced">Thành thạo</option></select></label><label>Đã dùng vào việc gì?<input name="use"/></label><button class="tc-button" type="submit">Thêm kỹ năng</button></form></section>
        <section class="tc-card"><h2>Minh chứng và trải nghiệm</h2><div class="tc-list"><article t-foreach="evidence_items" t-as="evidence"><strong t-esc="evidence.title"/><span t-esc="evidence.role"/><p t-esc="evidence.description or ''"/><p t-if="evidence.result"><strong>Kết quả:</strong> <span t-esc="evidence.result"/></p><a t-if="evidence.url" t-att-href="evidence.url" target="_blank" rel="noopener noreferrer">Xem liên kết minh chứng ↗</a><small t-esc="dict(evidence._fields['status'].selection).get(evidence.status)"/><details t-if="edit"><summary>Sửa minh chứng</summary><form t-att-action="'/tuhoso/evidence/%s/save' % evidence.id" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Tên dự án / hoạt động<input name="title" required="required" t-att-value="evidence.title"/></label><label>Vai trò<input name="role" required="required" t-att-value="evidence.role"/></label><label>Bạn đã làm gì?<textarea name="description" rows="3"><t t-esc="evidence.description or ''"/></textarea></label><label>Kết quả<input name="result" t-att-value="evidence.result or ''"/></label><label>Liên kết<input name="url" type="url" t-att-value="evidence.url or ''"/></label><label>Ai được xem?<select name="visibility"><option value="private" t-att-selected="'selected' if evidence.visibility == 'private' else None">Riêng tư</option><option value="members" t-att-selected="'selected' if evidence.visibility == 'members' else None">Thành viên</option><option value="public" t-att-selected="'selected' if evidence.visibility == 'public' else None">Công khai</option></select></label><button class="tc-button" type="submit">Lưu minh chứng</button></form><form t-att-action="'/tuhoso/evidence/%s/delete' % evidence.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="tc-button tc-outline" type="submit">Xóa minh chứng</button></form></details></article></div><p t-if="not evidence_items" class="tc-empty">Chưa có minh chứng được chia sẻ.</p><form t-if="edit" action="/tuhoso/evidence/add" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Tên dự án / hoạt động<input name="title" required="required"/></label><label>Vai trò của bạn<input name="role" required="required"/></label><label>Bạn đã làm gì?<textarea name="description" rows="3"/></label><label>Kết quả<input name="result"/></label><label>Liên kết minh chứng<input name="url" type="url"/></label><button class="tc-button" type="submit">Thêm minh chứng</button></form></section>
      </div><aside class="tc-stack">
        <section t-if="edit" class="tc-card"><h2>Chỉnh sửa hồ sơ</h2><form action="/tuhoso/profile/save" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Họ và tên<input name="name" required="required" t-att-value="profile.name"/></label><label>Giới thiệu ngắn<input name="headline" t-att-value="profile.headline or ''"/></label><label>Học vấn<input name="education" t-att-value="profile.education or ''"/></label><label>Lĩnh vực<select name="sector"><option value="">Chọn lĩnh vực</option><option t-foreach="sectors" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if profile.sector == opt[0] else None" t-esc="opt[1]"/></select></label><label>Địa điểm<input name="location" t-att-value="profile.location or ''"/></label><label>Định hướng<textarea name="goal" rows="3"><t t-esc="profile.goal or ''"/></textarea></label><label>Hình thức<select name="mode"><option value="">Chọn hình thức</option><option t-foreach="modes" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if profile.mode == opt[0] else None" t-esc="opt[1]"/></select></label><label>Thời gian sẵn sàng<input name="availability" t-att-value="profile.availability or ''"/></label><label>Mức mong muốn<input name="pay" t-att-value="profile.pay or ''"/></label><button class="tc-button" type="submit">Lưu hồ sơ</button></form></section>
        <section t-if="edit" class="tc-card"><h2>Quyền chia sẻ</h2><form action="/tuhoso/sharing/save" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Ai xem được?<select name="scope"><option value="private" t-att-selected="'selected' if profile.scope == 'private' else None">Riêng tư</option><option value="members" t-att-selected="'selected' if profile.scope == 'members' else None">Thành viên đăng nhập</option><option value="public" t-att-selected="'selected' if profile.scope == 'public' else None">Mọi người</option></select></label><label class="tc-check"><input type="checkbox" name="visible" t-att-checked="'checked' if profile.visible else None"/><span>Hiển thị trong gợi ý kết nối</span></label><label class="tc-check"><input type="checkbox" name="matching" t-att-checked="'checked' if matching_enabled else None"/><span>Đồng ý xử lý hồ sơ để gợi ý phù hợp</span></label><p>Email chỉ chia sẻ riêng cho từng tổ chức sau khi bạn đồng ý trao đổi.</p><button class="tc-button" type="submit">Lưu quyền chia sẻ</button></form><p t-if="profile.visible and profile.scope == 'public'"><a t-att-href="'/tuhoso/profile/%s' % profile.id">Xem hồ sơ công khai →</a></p></section>
        <section t-if="not edit" class="tc-card"><h2>Kết nối</h2><p>Đăng nhập để xem cơ hội và gửi lời mời trao đổi.</p><a class="tc-button" href="/tacare/matching">Xem sự phù hợp</a></section>
      </aside></div>
    </t>
  </template>
  <template id="live_matching" name="TA.CARE - Sự phù hợp">
    <t t-call="tacare_website.live_layout"><div class="tc-page-head"><p class="tc-eyebrow">TA.CARE</p><h1>Sự phù hợp có lý do</h1><p>Điểm gợi ý thử nghiệm dựa trên kỹ năng, hình thức và địa điểm. Hồ sơ chỉ tham gia khi ứng viên cấp quyền.</p></div>
      <form t-if="kind == 'profiles'" action="/tacare/matching" method="get" class="tc-filter"><label>Chọn tin tuyển dụng<select name="job"><option t-foreach="jobs" t-as="job" t-att-value="job.id" t-att-selected="'selected' if selected and selected.id == job.id else None" t-esc="job.name"/></select></label><button class="tc-button" type="submit">Xem gợi ý</button><a class="tc-button tc-outline" href="/kvl/manage">Quản lý tin</a></form>
      <p t-if="kind == 'jobs' and not matching_enabled" class="tc-alert">Bật quyền xử lý matching trong <a href="/tuhoso/me">hồ sơ của bạn</a> để nhận gợi ý.</p><p t-if="kind == 'jobs' and not profile.skill_ids" class="tc-alert">Thêm kỹ năng trong <a href="/tuhoso/me">hồ sơ của bạn</a> để gợi ý sát hơn.</p>
      <div class="tc-grid"><article t-foreach="matches" t-as="pair" class="tc-card"><t t-set="record" t-value="pair[0]"/><t t-set="reason" t-value="pair[1]"/><span class="tc-score"><span t-esc="reason['score']"/> / 100</span><p class="tc-eyebrow">ĐIỂM MÔ PHỎNG</p><h2 t-esc="record.name"/><p t-if="kind == 'jobs'" t-esc="record.tacare_owner_partner_id.name"/><p t-if="kind == 'profiles'" t-esc="record.headline or 'Hồ sơ năng lực'"/><p><strong>Đã khớp:</strong> <span t-esc="', '.join(reason['matched']) or 'Chưa có kỹ năng bắt buộc'"/></p><p><strong>Còn thiếu:</strong> <span t-esc="', '.join(reason['missing']) or 'Không thiếu kỹ năng bắt buộc'"/></p><a t-if="kind == 'jobs'" t-att-href="'/kvl/job/%s' % record.id">Xem cơ hội và ứng tuyển →</a><t t-else=""><a t-att-href="'/tuhoso/profile/%s' % record.id">Xem hồ sơ →</a><form t-if="selected and (role == 'admin' or selected.tacare_owner_partner_id.id in editable_org_ids)" action="/tacare/request/send" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="type" value="invitation"/><input type="hidden" name="job_id" t-att-value="selected.id"/><input type="hidden" name="profile_id" t-att-value="record.id"/><label>Lời mời<textarea name="message" rows="2" required="required"/></label><button class="tc-button" type="submit">Gửi lời mời</button></form></t></article></div><p t-if="not matches" class="tc-empty">Chưa có gợi ý. Hãy tạo tin hoặc hoàn thiện hồ sơ trước.</p>
    </t>
  </template>
  <template id="live_connections" name="TA.CARE - Kết nối"><t t-call="tacare_website.live_layout"><div class="tc-page-head"><p class="tc-eyebrow">TA.CARE</p><h1>Đề nghị và lời mời</h1><p>Theo dõi phản hồi của hai phía tại đây.</p></div><div class="tc-list"><article t-foreach="items" t-as="item" class="tc-card"><span class="tc-eyebrow" t-esc="dict(item._fields['type'].selection).get(item.type)"/><h2><a t-att-href="'/tacare/connection/%s' % item.id" t-esc="item.job_id.name"/></h2><p><span t-esc="item.snapshot_name"/> · <span t-esc="dict(item._fields['status'].selection).get(item.status)"/></p><p t-esc="item.message or ''"/><a t-att-href="'/tacare/connection/%s' % item.id">Xem chi tiết →</a></article></div><p t-if="not items" class="tc-empty">Chưa có đề nghị nào.</p></t></template>
  <template id="live_connection_detail" name="TA.CARE - Chi tiết kết nối"><t t-call="tacare_website.live_layout"><p class="tc-breadcrumb"><a href="/tacare/connections">Kết nối</a> / <span t-esc="item.job_id.name"/></p><div class="tc-page-head"><p class="tc-eyebrow" t-esc="dict(item._fields['type'].selection).get(item.type)"/><h1 t-esc="item.job_id.name"/><p><span t-esc="item.snapshot_name"/> · <span t-esc="dict(item._fields['status'].selection).get(item.status)"/></p></div><div class="tc-detail-grid"><section class="tc-card"><h2>Thông tin đề nghị</h2><p t-esc="item.message or 'Không có lời nhắn'"/><p><strong>Hồ sơ khi gửi:</strong> <span t-esc="item.snapshot_headline or 'Chưa có giới thiệu'"/></p><p><strong>Kỹ năng:</strong> <span t-esc="item.snapshot_skills or 'Chưa cập nhật'"/></p><p t-if="show_contact"><strong>Email liên hệ:</strong> <span t-esc="item.profile_id.user_id.partner_id.email or 'Chưa cung cấp'"/></p><p t-else="">Ứng viên chưa cấp quyền email cho tổ chức này hoặc đã thu hồi quyền.</p><form t-if="role == 'candidate' and item.profile_id.user_id.id == request.env.user.id and item.status == 'accepted'" t-att-action="'/tacare/connection/%s/contact' % item.id" method="post" class="tc-inline-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button t-if="show_contact" type="submit" name="action" value="revoke">Thu hồi quyền email</button><button t-else="" type="submit" name="action" value="grant">Chia sẻ email cho tổ chức này</button></form><p t-if="item.result"><strong>Kết quả:</strong> <span t-esc="dict(item._fields['result'].selection).get(item.result)"/></p><p t-if="item.result_note" t-esc="item.result_note"/></section><aside class="tc-card"><h2>Phản hồi</h2><form t-if="item.status == 'pending' and item.receiver_id.id == request.env.user.id" t-att-action="'/tacare/connection/%s/respond' % item.id" method="post" class="tc-stack"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="tc-button" name="status" value="accepted" type="submit">Đồng ý trao đổi</button><button class="tc-button tc-outline" name="status" value="declined" type="submit">Từ chối</button></form><form t-if="item.status == 'pending' and item.sender_id.id == request.env.user.id" t-att-action="'/tacare/connection/%s/cancel' % item.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="tc-button tc-outline" type="submit">Hủy đề nghị</button></form><form t-if="item.status == 'accepted'" t-att-action="'/tacare/connection/%s/result' % item.id" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Kết quả<select name="result"><option value="discussed">Đã trao đổi</option><option value="reviewing">Đang xem xét</option><option value="joined">Tham gia cơ hội</option><option value="stopped">Không tiếp tục</option></select></label><label>Ghi chú<textarea name="note" rows="3"/></label><button class="tc-button" type="submit">Lưu kết quả</button></form></aside></div></t></template>
  <template id="live_notifications" name="TA.CARE - Thông báo"><t t-call="tacare_website.live_layout"><div class="tc-page-head"><p class="tc-eyebrow">TA.CARE</p><h1>Thông báo</h1></div><div class="tc-list"><article t-foreach="items" t-as="item" t-att-class="'tc-card' + ('' if item.is_read else ' tc-unread')"><p t-esc="item.message"/><a t-if="item.connection_id" t-att-href="'/tacare/connection/%s' % item.connection_id.id">Xem kết nối →</a><form t-if="not item.is_read" t-att-action="'/tacare/notification/%s/read' % item.id" method="post" class="tc-inline-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit">Đánh dấu đã đọc</button></form></article></div><p t-if="not items" class="tc-empty">Chưa có thông báo.</p></t></template>

  <template id="live_home" name="TA.CARE live home">
    <t t-call="tacare_website.live_layout">
      <section t-att-class="'tc-hero tc-hero-' + site">
        <div>
          <p class="tc-eyebrow" t-esc="{'khovieclam':'KHO CƠ HỘI','tuhoso':'HỒ SƠ NĂNG LỰC','tacare':'HỆ SINH THÁI TA.CARE'}[site]"/>
          <t t-if="site == 'khovieclam'"><h1>Tìm việc phù hợp với điều bạn đang có.</h1><p>Việc làm, thực tập, dự án và task được trình bày rõ nhu cầu để bạn chọn bước tiếp theo.</p><div class="tc-actions"><a class="tc-button" href="/kvl/jobs">Khám phá cơ hội</a><a t-if="role in ('business','admin')" class="tc-button tc-outline" href="/kvl/manage">Quản lý tin của tổ chức</a><a t-elif="is_guest" class="tc-button tc-outline" href="/web/login?redirect=/kvl/manage">Doanh nghiệp đăng nhập</a></div></t>
          <t t-elif="site == 'tuhoso'"><h1>Mỗi bước bạn đi qua đều có giá trị.</h1><p>Tạo hồ sơ năng lực sống từ học vấn, kỹ năng và những việc đã làm. Bạn tự chọn cách chia sẻ.</p><div class="tc-actions"><a t-if="role == 'candidate'" class="tc-button" href="/tuhoso/me">Mở hồ sơ của tôi</a><a t-else="" class="tc-button" href="/web/login?redirect=/tuhoso/me">Đăng nhập để tạo hồ sơ</a><a class="tc-button tc-outline" href="/kvl/jobs">Xem cơ hội</a></div></t>
          <t t-else=""><h1>Năng lực được nhìn thấy. Cơ hội được kết nối.</h1><p>Hai phía có thể hiểu vì sao phù hợp, trao đổi với nhau và tự quyết định kết quả.</p><div class="tc-actions"><a t-if="not is_guest" class="tc-button" href="/tacare/matching">Xem sự phù hợp</a><a t-else="" class="tc-button" href="/web/login?redirect=/tacare/matching">Đăng nhập để kết nối</a><a class="tc-button tc-outline" href="/kvl/jobs">Xem cơ hội công khai</a></div></t>
        </div>
        <div t-if="site == 'khovieclam'" class="tc-category-board" aria-label="Danh mục cơ hội">
          <div class="tc-category-head"><span>Danh mục nổi bật</span><strong><t t-esc="job_count"/> cơ hội đang hiển thị</strong></div>
          <a t-foreach="sectors[:5]" t-as="sector" t-att-href="'/kvl/jobs?sector=%s' % sector[0]" class="tc-category-row"><span t-esc="'%02d' % (sector_index + 1)"/><strong t-esc="sector[1]"/><span aria-hidden="true">→</span></a>
        </div>
        <div t-elif="site == 'tuhoso'" class="tc-folio" aria-label="Hành trình hồ sơ">
          <div class="tc-folio-paper"><p>01 / BẠN LÀ AI</p><p>02 / BẠN BIẾT GÌ</p><p>03 / BẠN ĐÃ LÀM</p><p>04 / BẠN MUỐN GÌ</p><strong>Hồ sơ của bạn, theo nhịp của bạn.</strong></div>
        </div>
        <div t-else="" class="tc-bridge" aria-label="Năng lực kết nối cơ hội">
          <div class="tc-bridge-flow"><div><span class="tc-bridge-dot tc-bridge-blue"/><strong>Năng lực</strong><small>Tủ Hồ Sơ</small></div><span class="tc-bridge-line">Hiểu nhau để kết nối</span><div><span class="tc-bridge-dot tc-bridge-green"/><strong>Cơ hội</strong><small>Kho Việc Làm</small></div></div>
        </div>
      </section>
      <section t-if="site == 'khovieclam'" class="tc-section">
        <div class="tc-section-heading"><div><p class="tc-eyebrow">MỞ CHO BẠN</p><h2>Cơ hội mới để bắt đầu</h2></div><a class="tc-inline-link" href="/kvl/jobs">Xem tất cả →</a></div>
        <div class="tc-grid"><article t-foreach="jobs" t-as="job" class="tc-card tc-job-card"><span class="tc-card-kicker" t-esc="dict(sectors).get(job.tacare_sector, 'Cơ hội')"/><h3><a t-att-href="'/kvl/job/%s' % job.id" t-esc="job.name"/></h3><p><span t-esc="job.tacare_owner_partner_id.name"/> · <span t-esc="job.tacare_location"/></p><div class="tc-tags"><span t-esc="dict(types).get(job.tacare_type, '')"/><span t-esc="dict(modes).get(job.tacare_mode, '')"/></div><div class="tc-card-foot"><span>Hạn nhận: <t t-esc="job.tacare_deadline or 'Chưa nêu'"/></span><a t-att-href="'/kvl/job/%s' % job.id">Chi tiết →</a></div></article></div>
        <p t-if="not jobs" class="tc-empty">Chưa có tin nào được đăng. Doanh nghiệp có thể đăng nhập để tạo tin đầu tiên.</p>
      </section>
      <section t-else="" class="tc-section"><div class="tc-section-heading"><div><p class="tc-eyebrow" t-esc="'XÂY DỰNG DẦN' if site == 'tuhoso' else 'MỘT HÀNH TRÌNH LIÊN TỤC'"/><h2 t-esc="'Hồ sơ lớn lên cùng bạn' if site == 'tuhoso' else 'Từ điều đã làm đến bước tiếp theo'"/></div></div><div class="tc-steps"><article><span>01</span><h3>Con người</h3><p>Hồ sơ ghi lại kỹ năng, dự án và định hướng.</p><a t-att-href="urls['tuhoso']">Khám phá Tủ Hồ Sơ →</a></article><article><span>02</span><h3>Cơ hội</h3><p>Tin nêu rõ việc cần làm và điều kiện tham gia.</p><a href="/kvl/jobs">Tìm cơ hội →</a></article><article><span>03</span><h3>Trao đổi</h3><p>Hai bên phản hồi đề nghị, rồi ghi nhận kết quả riêng.</p><a t-att-href="'/tacare/connections' if not is_guest else '/web/login?redirect=/tacare/connections'">Xem kết nối →</a></article></div></section>
    </t>
  </template>

  <template id="live_jobs" name="Kho Việc Làm - Danh sách">
    <t t-call="tacare_website.live_layout">
      <div class="tc-page-head"><p class="tc-eyebrow">KHO VIỆC LÀM</p><h1>Khám phá cơ hội</h1><p>Tìm công việc, thực tập và dự án phù hợp với bước tiếp theo của bạn.</p></div>
      <div class="tc-list-layout"><form action="/kvl/jobs" method="get" class="tc-filter">
        <h2>Lọc cơ hội</h2>
        <label>Từ khóa<input type="search" name="q" t-att-value="query.get('q') or ''" placeholder="Tên tin hoặc địa điểm"/></label>
        <label>Lĩnh vực<select name="sector"><option value="">Tất cả lĩnh vực</option><option t-foreach="sectors" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if query.get('sector') == opt[0] else None" t-esc="opt[1]"/></select></label>
        <label>Loại cơ hội<select name="type"><option value="">Tất cả loại</option><option t-foreach="types" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if query.get('type') == opt[0] else None" t-esc="opt[1]"/></select></label>
        <button type="submit" class="tc-button">Tìm cơ hội</button><a href="/kvl/jobs" class="tc-button tc-outline">Xóa lọc</a>
      </form>
      <div class="tc-results"><div class="tc-results-head"><h2>Kết quả tìm kiếm</h2><span><strong t-esc="len(jobs)"/> cơ hội</span></div>
        <div class="tc-grid"><article t-foreach="jobs" t-as="job" class="tc-card tc-job-card"><span class="tc-card-kicker" t-esc="dict(sectors).get(job.tacare_sector, 'Cơ hội')"/><h2><a t-att-href="'/kvl/job/%s' % job.id" t-esc="job.name"/></h2><p><span t-esc="job.tacare_owner_partner_id.name"/> · <span t-esc="job.tacare_location"/> · <span t-esc="dict(modes).get(job.tacare_mode, '')"/></p><div class="tc-tags"><span t-esc="dict(types).get(job.tacare_type, '')"/><span t-esc="job.tacare_required_skills"/></div><div class="tc-card-foot"><span>Hạn nhận: <t t-esc="job.tacare_deadline or 'Chưa nêu'"/></span><a t-att-href="'/kvl/job/%s' % job.id">Xem chi tiết →</a></div></article></div>
        <div t-if="not jobs" class="tc-empty"><h3>Chưa tìm thấy cơ hội phù hợp</h3><p>Thử bỏ bớt bộ lọc để xem toàn bộ tin đang mở.</p><a href="/kvl/jobs">Xóa bộ lọc →</a></div>
      </div></div>
    </t>
  </template>

  <template id="live_job_detail" name="Kho Việc Làm - Chi tiết">
    <t t-call="tacare_website.live_layout">
      <p class="tc-breadcrumb"><a href="/kvl/jobs">Cơ hội</a> / <span t-esc="job.name"/></p>
      <div class="tc-detail-grid"><div><div class="tc-page-head"><p class="tc-eyebrow" t-esc="dict(sectors).get(job.tacare_sector, '')"/><h1 t-esc="job.name"/><p><span t-esc="job.tacare_owner_partner_id.name"/> · <span t-esc="job.tacare_location"/> · <span t-esc="dict(modes).get(job.tacare_mode, '')"/></p></div><section class="tc-card"><h2>Việc bạn sẽ làm</h2><div t-field="job.description"/><p><strong>Đầu ra:</strong> <span t-esc="job.tacare_outcome or 'Trao đổi khi kết nối'"/></p></section><section class="tc-card"><h2>Kỹ năng và điều kiện</h2><p><strong>Bắt buộc:</strong> <span t-esc="', '.join(required) or 'Chưa nêu'"/></p><p><strong>Ưu tiên:</strong> <span t-esc="', '.join(preferred) or 'Không có'"/></p><p><strong>Lịch:</strong> <span t-esc="job.tacare_schedule or 'Trao đổi khi kết nối'"/></p></section><section t-if="match" class="tc-card"><h2>Lý do phù hợp với hồ sơ của bạn</h2><strong class="tc-score"><span t-esc="match['score']"/> / 100</strong><p>Điểm phù hợp mô phỏng</p><p><strong>Đã có:</strong> <span t-esc="', '.join(match['matched']) or 'Chưa có kỹ năng bắt buộc'"/></p><p><strong>Còn thiếu:</strong> <span t-esc="', '.join(match['missing']) or 'Không thiếu kỹ năng bắt buộc'"/></p></section></div>
      <aside class="tc-card"><h2>Thông tin cơ hội</h2><dl><dt>Loại</dt><dd t-esc="dict(types).get(job.tacare_type, '')"/><dt>Hạn nhận</dt><dd t-esc="job.tacare_deadline or 'Chưa nêu'"/><dt>Số lượng</dt><dd t-esc="job.no_of_recruitment"/><dt>Thù lao</dt><dd t-esc="job.tacare_pay or 'Chưa công bố'"/></dl><t t-if="role == 'candidate' and profile"><form action="/tacare/request/send" method="post" class="tc-stack"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="type" value="application"/><input type="hidden" name="job_id" t-att-value="job.id"/><input type="hidden" name="profile_id" t-att-value="profile.id"/><label>Lời nhắn<textarea name="message" rows="3" required="required" placeholder="Vì sao bạn quan tâm cơ hội này?"/></label><p>Email của bạn chỉ hiện nếu bạn cấp quyền riêng sau khi hai bên đồng ý trao đổi.</p><button class="tc-button" type="submit">Gửi đề nghị ứng tuyển</button></form></t><a t-elif="is_guest" class="tc-button" t-att-href="'/web/login?redirect=/kvl/job/%s' % job.id">Đăng nhập để ứng tuyển</a><a t-elif="role in ('business','admin')" class="tc-button tc-outline" href="/kvl/manage">Quản lý tin</a></aside></div>
    </t>
  </template>

  <template id="live_manage_jobs" name="Kho Việc Làm - Quản lý">
    <t t-call="tacare_website.live_layout"><div class="tc-page-head"><p class="tc-eyebrow">DOANH NGHIỆP</p><h1>Tin của tổ chức</h1><p>Mỗi tin thuộc đúng tổ chức của tài khoản đang đăng nhập.</p><a t-if="role == 'admin' or editable_org_ids" class="tc-button" href="/kvl/job/new">Tạo tin mới</a></div>
      <div class="tc-tabs"><a href="/kvl/manage">Tất cả</a><a href="/kvl/manage?status=draft">Nháp</a><a href="/kvl/manage?status=published">Đang hiển thị</a><a href="/kvl/manage?status=paused">Tạm ngừng</a><a href="/kvl/manage?status=closed">Đã đóng</a></div>
      <div class="tc-card tc-table-wrap"><table><thead><tr><th>Vị trí</th><th>Loại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><tr t-foreach="jobs" t-as="job"><td><a t-att-href="'/kvl/job/%s' % job.id" t-esc="job.name"/></td><td t-esc="dict(types).get(job.tacare_type, '')"/><td t-esc="dict([('draft','Nháp'),('published','Đang hiển thị'),('paused','Tạm ngừng'),('closed','Đã đóng')]).get(job.tacare_status)"/><td><a t-if="job.tacare_status != 'closed' and (role == 'admin' or job.tacare_owner_partner_id.id in editable_org_ids)" t-att-href="'/kvl/job/%s/edit' % job.id">Sửa</a><form t-if="job.tacare_status in ('draft','paused','published') and (role == 'admin' or job.tacare_owner_partner_id.id in editable_org_ids)" t-att-action="'/kvl/job/%s/status' % job.id" method="post" class="tc-inline-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button t-if="job.tacare_status in ('draft','paused')" type="submit" name="status" value="published">Đăng/mở lại</button><button t-if="job.tacare_status == 'published'" type="submit" name="status" value="paused">Tạm ngừng</button><button t-if="job.tacare_status in ('published','paused')" type="submit" name="status" value="closed">Đóng tin</button></form></td></tr></tbody></table><p t-if="not jobs" class="tc-empty">Chưa có tin ở trạng thái này.</p></div><section t-if="revisions" class="tc-card"><h2>Bản sửa chờ duyệt</h2><article t-foreach="revisions" t-as="revision" class="tc-revision"><strong t-esc="revision.job_id.name"/><p>Phiên bản <span t-esc="revision.version"/> · Người gửi: <span t-esc="revision.submitted_by.name"/></p><details><summary>Xem nội dung đề xuất</summary><pre t-esc="revision.payload"/></details><form t-if="role == 'admin'" t-att-action="'/kvl/revision/%s/review' % revision.id" method="post" class="tc-mini-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Ghi chú duyệt<input name="note"/></label><div class="tc-actions"><button class="tc-button" type="submit" name="decision" value="approve">Duyệt và áp dụng</button><button class="tc-button tc-outline" type="submit" name="decision" value="reject">Từ chối</button></div></form></article></section><p><a href="/tacare/connections">Xem đề nghị và lời mời →</a></p>
    </t>
  </template>

  <template id="live_job_form" name="Kho Việc Làm - Form tin">
    <t t-call="tacare_website.live_layout"><p class="tc-breadcrumb"><a href="/kvl/manage">Tin của tổ chức</a> / <span t-esc="'Sửa tin' if job else 'Tạo tin'"/></p><div class="tc-page-head"><p class="tc-eyebrow">BIÊN TẬP CƠ HỘI</p><h1 t-esc="'Sửa tin' if job else 'Tạo tin mới'"/><p>Lưu nháp trước hoặc điền đủ các trường bắt buộc để đăng.</p></div><div t-if="error" class="tc-error" role="alert" t-esc="error"/>
      <form action="/kvl/job/save" method="post" class="tc-card tc-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input t-if="job" type="hidden" name="job_id" t-att-value="job.id"/><div t-if="owners" class="tc-field"><label for="owner_id">Tổ chức đăng tin</label><select id="owner_id" name="owner_id"><option t-foreach="owners" t-as="owner" t-att-value="owner.id" t-esc="owner.partner_id.commercial_partner_id.name"/></select></div>
        <div t-if="organizations and len(organizations) &gt; 1 and not job" class="tc-field"><label for="organization_id">Tổ chức đăng tin</label><select id="organization_id" name="organization_id" required="required"><option t-foreach="organizations" t-as="organization" t-att-value="organization.id" t-esc="organization.name"/></select></div><div class="tc-form-grid"><div class="tc-field"><label for="name">Tên cơ hội *</label><input id="name" name="name" required="required" t-att-value="vals.get('name') if vals else job.name if job else ''"/></div><div class="tc-field"><label for="sector">Lĩnh vực *</label><select id="sector" name="sector" required="required"><option value="">Chọn lĩnh vực</option><option t-foreach="sectors" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if (vals.get('sector') if vals else job.tacare_sector if job else '') == opt[0] else None" t-esc="opt[1]"/></select></div><div class="tc-field"><label for="type">Loại cơ hội *</label><select id="type" name="type" required="required"><option value="">Chọn loại</option><option t-foreach="types" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if (vals.get('type') if vals else job.tacare_type if job else '') == opt[0] else None" t-esc="opt[1]"/></select></div><div class="tc-field"><label for="mode">Hình thức *</label><select id="mode" name="mode" required="required"><option value="">Chọn hình thức</option><option t-foreach="modes" t-as="opt" t-att-value="opt[0]" t-att-selected="'selected' if (vals.get('mode') if vals else job.tacare_mode if job else '') == opt[0] else None" t-esc="opt[1]"/></select></div><div class="tc-field"><label for="location">Địa điểm *</label><input id="location" name="location" required="required" t-att-value="vals.get('location') if vals else job.tacare_location if job else ''"/></div><div class="tc-field"><label for="quantity">Số lượng</label><input id="quantity" name="quantity" type="number" min="1" t-att-value="vals.get('quantity') if vals else job.no_of_recruitment if job else 1"/></div><div class="tc-field"><label for="start">Ngày bắt đầu</label><input id="start" name="start" type="date" t-att-value="vals.get('start') if vals else str(job.tacare_start or '') if job else ''"/></div><div class="tc-field"><label for="deadline">Hạn nhận đề nghị *</label><input id="deadline" name="deadline" type="date" required="required" t-att-value="vals.get('deadline') if vals else str(job.tacare_deadline or '') if job else ''"/></div><div class="tc-field"><label for="experience_min">Kinh nghiệm tối thiểu (năm)</label><input id="experience_min" name="experience_min" type="number" min="0" step="0.5" t-att-value="vals.get('experience_min') if vals else job.care_experience_min if job else 0"/></div><div class="tc-field"><label for="salary_min">Thù lao tối thiểu</label><input id="salary_min" name="salary_min" type="number" min="0" t-att-value="vals.get('salary_min') if vals else job.care_salary_min if job else 0"/></div><div class="tc-field"><label for="salary_max">Thù lao tối đa</label><input id="salary_max" name="salary_max" type="number" min="0" t-att-value="vals.get('salary_max') if vals else job.care_salary_max if job else 0"/></div><div class="tc-field"><label for="schedule">Lịch / thời lượng</label><input id="schedule" name="schedule" t-att-value="vals.get('schedule') if vals else job.tacare_schedule if job else ''"/></div><div class="tc-field"><label for="pay">Thù lao / lương</label><input id="pay" name="pay" t-att-value="vals.get('pay') if vals else job.tacare_pay if job else ''"/></div><div class="tc-field"><label for="required_skills">Kỹ năng bắt buộc * (cách nhau bằng dấu phẩy)</label><input id="required_skills" name="required_skills" required="required" t-att-value="vals.get('required_skills') if vals else job.tacare_required_skills if job else ''"/></div><div class="tc-field"><label for="preferred_skills">Kỹ năng ưu tiên</label><input id="preferred_skills" name="preferred_skills" t-att-value="vals.get('preferred_skills') if vals else job.tacare_preferred_skills if job else ''"/></div></div>
        <div class="tc-field"><label for="description">Nhiệm vụ và mô tả *</label><textarea id="description" name="description" rows="5" required="required"><t t-esc="vals.get('description') if vals else job.tacare_description_text if job else ''"/></textarea></div><div class="tc-field"><label for="outcome">Đầu ra mong đợi</label><textarea id="outcome" name="outcome" rows="3"><t t-esc="vals.get('outcome') if vals else job.tacare_outcome if job else ''"/></textarea></div><label class="tc-check"><input type="checkbox" name="matching_enabled" t-att-checked="'checked' if (vals.get('matching_enabled') == 'on' if vals else job.care_matching_enabled if job else True) else None"/><span>Cho phép gợi ý kết nối cho tin này</span></label><div class="tc-actions"><button class="tc-button tc-outline" type="submit" name="intent" value="draft" formnovalidate="formnovalidate">Lưu nháp</button><button class="tc-button" type="submit" name="intent" value="publish">Đăng tin</button><a class="tc-button tc-plain" href="/kvl/manage">Hủy</a></div></form>
    </t>
  </template>
</odoo>
