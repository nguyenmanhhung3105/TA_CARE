<?xml version='1.0' encoding='utf-8'?>
<odoo><template id="live_layout" name="TA.CARE live layout">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True" />
      <t t-set="no_footer" t-value="True" />
      <div id="wrap" t-att-class="'tc-live tc-%s %s' % (site, {'khovieclam': 'tc-jobs', 'tuhoso': 'tc-profiles', 'tacare': 'tc-hub'}[site])">
        <a class="tc-skip" href="#tc-main">Đến nội dung chính</a>
        <div t-if="request.httprequest.host.split(':', 1)[0].endswith('.localhost')" class="tc-demo-note">
          <div class="tc-container tc-demo-inner">
            <span>TA.CARE · MÔI TRƯỜNG THỬ NGHIỆM</span>
            <span>Con người · Năng lực · Cơ hội</span>
          </div>
        </div>
        <t t-if="home_page" t-call="tacare_website.home_navigation" />
        <header t-if="not home_page" t-att-class="'tc-header tc-header-auth' if not is_guest else 'tc-header'">
          <div class="tc-container tc-header-inner">
            <a t-att-href="urls[site]" class="tc-brand">
              <img t-att-src="'/tacare_website/static/src/img/%s.png' % site" t-att-alt="'Logo ' + site" />
              <span>
                <strong t-esc="{'khovieclam':'Kho Việc Làm','tuhoso':'Tủ Hồ Sơ','tacare':'TA.CARE'}[site]" />
                <small t-esc="{'khovieclam':'khovieclam.vn','tuhoso':'tuhoso.com','tacare':'tacare.vn'}[site]" />
              </span>
            </a>
            <nav aria-label="Điều hướng chính" class="tc-nav">
              <t t-if="site == 'khovieclam'">
                <a t-att-href="urls['khovieclam']">Trang chủ</a>
                <a href="/kvl/jobs">Cơ hội</a>
                <a t-if="role in ('business','admin')" href="/kvl/manage">Quản lý tin</a>

                <a t-if="role in ('business','admin')" href="/tacare/connections?type=application">Đề nghị</a>
                <a t-if="role in ('business','admin')" href="/tacare/connections?type=invitation">Lời mời</a>
                <a t-if="role in ('business','admin')" href="/tacare/notifications">Thông báo</a>
              </t>
              <t t-elif="site == 'tuhoso'">
                <a t-att-href="urls['tuhoso']">Trang chủ</a>
                <a t-if="role == 'candidate'" href="/tuhoso/me">Hồ sơ của tôi</a>
                <a href="/kvl/jobs">Tìm cơ hội</a>
              </t>
              <t t-else="">
                <a t-att-href="urls['tacare']">Hệ sinh thái</a>
                <a t-if="not is_guest" href="/tacare/matching">Phù hợp</a>
                <a t-if="not is_guest" href="/tacare/connections">Kết nối</a>
                <a t-if="not is_guest" href="/tacare/notifications">Thông báo</a>
              </t>
            </nav>
            <div class="tc-header-actions">
              <nav class="tc-site-switch" aria-label="Chuyển website">
                <a t-att-href="urls['khovieclam']" t-att-class="'is-current' if site == 'khovieclam' else ''">Kho Việc Làm</a>
                <a t-att-href="urls['tuhoso']" t-att-class="'is-current' if site == 'tuhoso' else ''">Tủ Hồ Sơ</a>
                <a t-att-href="urls['tacare']" t-att-class="'is-current' if site == 'tacare' else ''">TA.CARE</a>
              </nav>
              <a t-if="is_guest" class="tc-button tc-outline" t-att-href="'/web/login?redirect=%s' % request.httprequest.path">Đăng nhập</a>
              <t t-else="">
                <span class="tc-account" t-esc="account_name" />
                <a class="tc-small-link" href="/web/session/logout?redirect=/">Đăng xuất</a>
              </t>
            </div>
          </div>
        </header>
        <main id="tc-main" t-att-class="'tc-home-main' if home_page else 'tc-container'" tabindex="-1">
          <div t-if="notice" class="tc-alert" role="status">Đã cập nhật dữ liệu thành công.</div>
          <t t-out="0" />
        </main>
        <footer t-if="not home_page" class="tc-footer">
          <div class="tc-container">
            <a t-att-href="urls['tacare']">TA.CARE</a>
            <span>Con người · Năng lực · Cơ hội</span>
            <nav aria-label="Các website trong hệ sinh thái"><a t-foreach="switch_sites" t-as="key" t-if="key != site" t-att-href="urls[key]" t-esc="site_labels[key]" /></nav>
          </div>
        </footer>
      </div>
    </t>
  </template>
  <template id="comparison_rows" name="TA.CARE · Căn cứ đối chiếu">
    <div t-foreach="comparisons" t-as="item" class="tc-kvl-criterion">
      <span t-att-class="'tc-kvl-status is-' + item['result']" t-esc="{'met':'Có dữ liệu đáp ứng','unmet':'Có dữ liệu khác yêu cầu','unknown':'Chưa đủ thông tin'}[item['result']]" />
      <div>
        <strong t-esc="item['name']" />
        <small>
          <span t-esc="item['category']" />
          <t t-if="item['mandatory']"> · Bắt buộc</t>
        </small>
        <p t-esc="item['basis']" />
      </div>
    </div>
    <p t-if="not comparisons">Chưa có tiêu chí để đối chiếu.</p>
    <p class="tc-help">Dữ liệu tự khai cần được kiểm tra khi trao đổi. Thông tin chưa khai được giữ ở trạng thái chưa đủ thông tin.</p>
  </template>
  <template id="live_home" name="TA.CARE · Ba trang chủ độc lập">
    <t t-set="home_page" t-value="True" />
    <t t-call="tacare_website.live_layout">
      <t t-if="site == 'khovieclam'" t-call="tacare_website.home_jobs" />
      <t t-elif="site == 'tuhoso'" t-call="tacare_website.home_profiles" />
      <t t-else="" t-call="tacare_website.home_hub" />
    </t>
  </template>
  <template id="live_job_detail" name="Kho Việc Làm - Chi tiết">
    <t t-call="tacare_website.live_layout">
      <p class="tc-breadcrumb">
        <a href="/kvl/jobs">Cơ hội</a> / <span t-esc="job.name" />
      </p>
      <div class="tc-detail-grid">
        <div>
          <div class="tc-page-head">
            <p class="tc-eyebrow" t-esc="dict(sectors).get(job.tacare_sector, '')" />
            <h1 t-esc="job.name" />
            <p>
              <span t-esc="job.tacare_owner_partner_id.name" /> · <span t-esc="job.tacare_location" /> · <span t-esc="dict(modes).get(job.tacare_mode, '')" />
            </p>
          </div>
          <section class="tc-card">
            <h2>Việc bạn sẽ làm</h2>
            <div t-field="job.description" />
            <p>
              <strong>Đầu ra:</strong>
              <span t-esc="job.tacare_outcome or 'Trao đổi khi kết nối'" />
            </p>
          </section>
          <section class="tc-card">
            <h2>Kỹ năng và điều kiện</h2>
            <p>
              <strong>Bắt buộc:</strong>
              <span t-esc="', '.join(required) or 'Chưa nêu'" />
            </p>
            <p>
              <strong>Ưu tiên:</strong>
              <span t-esc="', '.join(preferred) or 'Không có'" />
            </p>
            <p>
              <strong>Lịch:</strong>
              <span t-esc="job.tacare_schedule or 'Trao đổi khi kết nối'" />
            </p>
          </section>
          <section t-if="match" class="tc-card">
            <h2>Lý do phù hợp với hồ sơ của bạn</h2>
            <p>Căn cứ đối chiếu từ kỹ năng đã khai.</p>
            <p>
              <strong>Đã có:</strong>
              <span t-esc="', '.join(match['matched']) or 'Chưa có kỹ năng bắt buộc'" />
            </p>
            <p>
              <strong>Chưa đủ thông tin:</strong>
              <span t-esc="', '.join(match['missing']) or 'Chưa xác định thêm'" />
            </p>
          </section>
        </div>
        <aside class="tc-card">
          <h2>Thông tin cơ hội</h2>
          <dl>
            <dt>Loại</dt>
            <dd t-esc="dict(types).get(job.tacare_type, '')" />
            <dt>Hạn nhận</dt>
            <dd t-esc="job.tacare_deadline or 'Chưa nêu'" />
            <dt>Số lượng</dt>
            <dd t-esc="job.no_of_recruitment" />
            <dt>Thù lao</dt>
            <dd t-esc="job.tacare_pay or 'Chưa công bố'" />
          </dl>
          <t t-if="role == 'candidate' and profile">
            <form action="/tacare/request/send" method="post" class="tc-stack">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
              <input type="hidden" name="type" value="application" />
              <input type="hidden" name="job_id" t-att-value="job.id" />
              <input type="hidden" name="profile_id" t-att-value="profile.id" />
              <label>Lời nhắn<textarea name="message" rows="3" required="required" placeholder="Vì sao bạn quan tâm cơ hội này?" />
              </label>
              <p>Email của bạn chỉ hiện nếu bạn cấp quyền riêng sau khi hai bên đồng ý trao đổi.</p>
              <button class="tc-button" type="submit">Gửi đề nghị ứng tuyển</button>
            </form>
          </t>
          <a t-elif="is_guest" class="tc-button" t-att-href="'/web/login?redirect=/kvl/job/%s' % job.id">Đăng nhập để ứng tuyển</a>
          <a t-elif="role in ('business','admin')" class="tc-button tc-outline" href="/kvl/manage">Quản lý tin</a>
        </aside>
      </div>
    </t>
  </template>
  <template id="live_manage_jobs" name="Kho Việc Làm - Quản lý">
    <t t-call="tacare_website.live_layout">
      <div class="tc-page-head">
        <p class="tc-eyebrow">DOANH NGHIỆP</p>
        <h1>Tin của tổ chức</h1>
        <p>Mỗi tin thuộc đúng tổ chức của tài khoản đang đăng nhập.</p>
        <a t-if="role == 'admin' or editable_org_ids" class="tc-button" href="/kvl/job/new">Tạo tin mới</a>
      </div>
      <div class="tc-tabs">
        <a href="/kvl/manage">Tất cả</a>
        <a href="/kvl/manage?status=draft">Nháp</a>
        <a href="/kvl/manage?status=published">Đang hiển thị</a>
        <a href="/kvl/manage?status=paused">Tạm ngừng</a>
        <a href="/kvl/manage?status=closed">Đã đóng</a>
      </div>
      <div class="tc-card tc-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Vị trí</th>
              <th>Loại</th>
              <th>Trạng thái</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="jobs" t-as="job">
              <td>
                <a t-att-href="'/kvl/job/%s' % job.id" t-esc="job.name" />
              </td>
              <td t-esc="dict(types).get(job.tacare_type, '')" />
              <td t-esc="dict([('draft','Nháp'),('published','Đang hiển thị'),('paused','Tạm ngừng'),('closed','Đã đóng')]).get(job.tacare_status)" />
              <td>
                <a t-if="job.tacare_status != 'closed' and (role == 'admin' or job.tacare_owner_partner_id.id in editable_org_ids)" t-att-href="'/kvl/job/%s/edit' % job.id">Sửa</a>
                <form t-if="job.tacare_status in ('draft','paused','published') and (role == 'admin' or job.tacare_owner_partner_id.id in editable_org_ids)" t-att-action="'/kvl/job/%s/status' % job.id" method="post" class="tc-inline-form">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                  <button t-if="job.tacare_status in ('draft','paused')" type="submit" name="status" value="published">Đăng/mở lại</button>
                  <button t-if="job.tacare_status == 'published'" type="submit" name="status" value="paused">Tạm ngừng</button>
                  <button t-if="job.tacare_status in ('published','paused')" type="submit" name="status" value="closed">Đóng tin</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
        <p t-if="not jobs" class="tc-empty">Chưa có tin ở trạng thái này.</p>
      </div>
      <section t-if="revisions" class="tc-card">
        <h2>Bản sửa chờ duyệt</h2>
        <article t-foreach="revisions" t-as="revision" class="tc-revision">
          <strong t-esc="revision.job_id.name" />
          <p>Phiên bản <span t-esc="revision.version" /> · Người gửi: <span t-esc="revision.submitted_by.name" />
          </p>
          <details>
            <summary>Xem nội dung đề xuất</summary>
            <pre t-esc="revision.payload" />
          </details>
          <form t-if="role == 'admin'" t-att-action="'/kvl/revision/%s/review' % revision.id" method="post" class="tc-mini-form">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
            <label>Ghi chú duyệt<input name="note" />
            </label>
            <div class="tc-actions">
              <button class="tc-button" type="submit" name="decision" value="approve">Duyệt và áp dụng</button>
              <button class="tc-button tc-outline" type="submit" name="decision" value="reject">Từ chối</button>
            </div>
          </form>
        </article>
      </section>
      <p>
        <a href="/tacare/connections">Xem đề nghị và lời mời </a>
      </p>
    </t>
  </template>
  </odoo>
