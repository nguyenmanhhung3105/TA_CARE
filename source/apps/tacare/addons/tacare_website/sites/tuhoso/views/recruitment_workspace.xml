<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="profile_timeline_form" name="Hồ sơ · Mục quá trình">
    <t t-set="entry_vals" t-value="child_values if child_form == timeline_kind + ('_edit' if timeline_row else '_add') and (not timeline_row or child_id == timeline_row.id) else (timeline_values.get(timeline_kind + '-' + str(timeline_row.id), {}) if timeline_row else {})"/>
    <form method="post" t-att-action="'/tuhoso/history/%s/save' % timeline_kind" class="tc-form rp-timeline-form" data-profile-timeline="1">
      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="profile_id" t-att-value="profile.id"/><input type="hidden" name="id" t-att-value="timeline_row.id if timeline_row else ''"/>
      <t t-if="timeline_kind == 'experience'"><div class="tc-form-grid"><label>Đơn vị / nhóm / dự án *<input name="organization" required="required" minlength="2" maxlength="180" t-att-value="entry_vals.get('organization','')" placeholder="Tên đơn vị hoặc nhóm thực hiện"/></label><label>Vị trí / vai trò *<input name="position" required="required" minlength="2" maxlength="180" t-att-value="entry_vals.get('position','')" placeholder="Ví dụ: Thực tập Frontend"/></label><label>Loại kinh nghiệm<select name="employment_type"><option value="">Chưa khai</option><option t-foreach="[('employment','Nhân viên'),('internship','Thực tập'),('freelance','Cộng tác / tự do'),('project','Dự án / tình nguyện')]" t-as="opt" t-att-value="opt[0]" t-att-selected="entry_vals.get('employment_type') == opt[0]" t-esc="opt[1]"/></select></label><label>Nơi làm việc<input name="location" maxlength="250" t-att-value="entry_vals.get('location','')" placeholder="Khu vực hoặc làm từ xa"/></label></div></t>
      <t t-else=""><div class="tc-form-grid"><label>Trường / cơ sở đào tạo *<input name="school" required="required" minlength="2" maxlength="180" t-att-value="entry_vals.get('school','')"/></label><label>Chuyên ngành / khóa học<input name="major" maxlength="180" t-att-value="entry_vals.get('major','')"/></label><label>Trình độ / văn bằng<select name="qualification_id"><option value="">Chưa khai / không áp dụng</option><option t-foreach="degree_options" t-as="d" t-att-value="d.id" t-att-selected="entry_vals.get('qualification_id') == str(d.id)" t-esc="d.name"/></select></label></div></t>
      <div class="tc-form-grid"><label>Từ tháng<input type="month" name="start_date" t-att-value="entry_vals.get('start_date','')"/></label><label>Đến tháng<input type="month" name="end_date" t-att-value="entry_vals.get('end_date','')" data-timeline-end="1"/></label></div><label class="tc-check"><input type="checkbox" name="is_current" t-att-checked="entry_vals.get('is_current') == 'on'" data-timeline-current="1"/><span t-esc="'Đang làm / đang tham gia' if timeline_kind == 'experience' else 'Đang theo học'"/></label>
      <t t-if="timeline_kind == 'experience'"><label>Công việc và trách nhiệm<textarea name="responsibilities" rows="4" maxlength="10000" placeholder="Phạm vi bạn phụ trách, đầu việc thường xuyên, quy mô nhóm / sản phẩm…"><t t-esc="entry_vals.get('responsibilities','')"/></textarea></label><label>Kết quả / đóng góp nổi bật<textarea name="achievements" rows="3" maxlength="10000" placeholder="Nêu kết quả có thể giải thích; phân biệt phần bạn làm với kết quả chung của nhóm."><t t-esc="entry_vals.get('achievements','')"/></textarea></label><label>Công cụ / phương pháp đã sử dụng<input name="tools" maxlength="500" t-att-value="entry_vals.get('tools','')" placeholder="Ví dụ: JavaScript, Git, kiểm thử giao diện…"/></label></t>
      <label t-else="">Nội dung học và kết quả liên quan<textarea name="description" rows="4" maxlength="10000" placeholder="Môn học liên quan, đồ án, thành tích hoặc hướng nghiên cứu; không cần nhập mã sinh viên."><t t-esc="entry_vals.get('description','')"/></textarea></label>
      <button class="tc-button tc-outline" type="submit" t-esc="'Lưu mục kinh nghiệm' if timeline_kind == 'experience' else 'Lưu mục học tập'"/>
    </form>
  </template>

  <template id="profile_timeline_list" name="Hồ sơ · Danh sách quá trình">
    <div class="rp-timeline-list"><article t-foreach="timeline_rows" t-as="timeline_row" class="rp-timeline-row" t-att-data-history-id="timeline_row.id">
      <h3 t-esc="timeline_row.position if timeline_kind == 'experience' else timeline_row.school"/><p class="rp-timeline-subtitle" t-esc="timeline_row.organization if timeline_kind == 'experience' else timeline_row.major or 'Chưa khai chuyên ngành'"/><p class="rp-timeline-date" t-esc="timeline_row._timeline_label()"/>
      <t t-if="timeline_kind == 'experience'"><p t-if="timeline_row.location" t-esc="timeline_row.location"/><p class="tc-prose" t-if="timeline_row.responsibilities" t-esc="timeline_row.responsibilities"/><p t-if="timeline_row.achievements" class="tc-prose"><strong>Đóng góp:</strong> <t t-esc="timeline_row.achievements"/></p><p t-if="timeline_row.tools"><strong>Công cụ:</strong> <t t-esc="timeline_row.tools"/></p></t>
      <t t-else=""><p t-if="timeline_row.qualification_id" t-esc="timeline_row.qualification_id.name"/><p class="tc-prose" t-if="timeline_row.description" t-esc="timeline_row.description"/></t>
      <t t-if="can_edit_timeline"><details t-att-open="'open' if child_form == timeline_kind + '_edit' and child_id == timeline_row.id else None"><summary>Chỉnh sửa mục này</summary><t t-call="tacare_website.profile_timeline_form"/></details><form method="post" t-att-action="'/tuhoso/history/%s/%s/delete' % (timeline_kind, timeline_row.id)" class="rp-history-delete"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="profile_id" t-att-value="profile.id"/><button type="submit" name="confirm" value="delete" class="tc-delete-link">Xóa mục</button></form></t>
    </article></div>
    <p t-if="not timeline_rows" class="tc-help" t-esc="'Chưa thêm công việc cụ thể. Có thể ghi cả thực tập, làm thêm và dự án nhóm.' if timeline_kind == 'experience' else 'Chưa thêm quá trình học tập. Có thể ghi chương trình đang học hoặc khóa đào tạo nghề.'"/>
    <details t-if="can_edit_timeline" class="rp-add-history" t-att-open="'open' if child_form == timeline_kind + '_add' or not timeline_rows else None"><summary t-esc="'Thêm một công việc / trải nghiệm' if timeline_kind == 'experience' else 'Thêm một quá trình học tập'"/><t t-call="tacare_website.profile_timeline_form"><t t-set="timeline_row" t-value="False"/></t></details>
  </template>

  <template id="recruitment_editor_details" inherit_id="tacare_website.live_profile" name="Hồ sơ tuyển dụng · Biểu mẫu chi tiết">
    <xpath expr="//form[@action='/tuhoso/profile/save']/input[@name='profile_id']" position="after"><input type="hidden" name="profile_version" t-att-value="profile.version"/></xpath>
    <xpath expr="//div[@t-if='error']" position="attributes"><attribute name="id">profile-editor-error</attribute><attribute name="tabindex">-1</attribute></xpath>
    <xpath expr="//form[@action='/tuhoso/profile/save']" position="before"><div t-if="profile.user_id != request.env.user" class="rp-admin-notice" role="status"><strong>Đang chỉnh sửa hồ sơ của <t t-esc="profile.user_id.name"/>.</strong><p>Thay đổi chỉ áp dụng cho hồ sơ đang mở. Quyền chia sẻ và đồng ý đối chiếu do chủ hồ sơ quyết định.</p></div><details class="rp-completion"><summary>Gợi ý hoàn thiện hồ sơ <span t-esc="'· còn %s nhóm có thể bổ sung' % len(recruitment_gaps) if recruitment_gaps else '· đã có thông tin các nhóm chính'"/></summary><ul t-if="recruitment_gaps"><li t-foreach="recruitment_gaps" t-as="gap" t-esc="gap"/></ul><p>Đây là gợi ý về thông tin còn trống, không phải điểm năng lực. Có thể lưu trước rồi bổ sung dần.</p></details></xpath>
    <xpath expr="//section[@id='profile-intro']/label[textarea[@name='bio']]/textarea" position="attributes"><attribute name="rows">5</attribute><attribute name="maxlength">20000</attribute><attribute name="placeholder">Bạn đang theo hướng nghề nào? Nêu 2–3 thế mạnh, kinh nghiệm hoặc dự án tiêu biểu và giá trị bạn có thể đóng góp.</attribute></xpath>
    <xpath expr="//section[@id='profile-intro']" position="inside"><label>Portfolio / GitHub / trang nghề nghiệp<input name="portfolio_url" type="url" maxlength="1000" t-att-value="vals.get('portfolio_url','')" placeholder="https://…"/><small>Tùy chọn. Chỉ thêm liên kết được phép chia sẻ; tài liệu và email không tự công khai theo liên kết này.</small></label></xpath>
    <xpath expr="//section[@id='profile-preferences']/div[hasclass('tc-form-grid')]" position="inside"><label>Cấp độ mong muốn<select name="career_level"><option value="">Chưa khai</option><option t-foreach="profile._fields['career_level'].selection" t-as="o" t-att-value="o[0]" t-att-selected="o[0] == vals.get('career_level')" t-esc="o[1]"/></select></label><label>Khả năng chuyển nơi ở<select name="relocation"><option value="">Chưa khai</option><option t-foreach="profile._fields['relocation'].selection" t-as="o" t-att-value="o[0]" t-att-selected="o[0] == vals.get('relocation')" t-esc="o[1]"/></select></label></xpath>
    <xpath expr="//section[@id='profile-preferences']" position="inside"><label>Điều kiện làm việc mong muốn<textarea name="preferred_conditions" rows="3" maxlength="20000" placeholder="Lịch có thể làm, cách phối hợp, điều kiện cần trao đổi; phân biệt điều kiện quan trọng và mong muốn thêm."><t t-esc="vals.get('preferred_conditions','')"/></textarea></label></xpath>
    <xpath expr="//details[.//input[@name='salary_min']]" position="attributes"><attribute name="open">open</attribute></xpath>
    <xpath expr="//label[input[@name='salary_min']]" position="after"><label>Mức mong muốn cao nhất (nếu có)<input name="salary_max" type="number" min="0" step="1000" t-att-value="vals.get('salary_max','')"/><small>Cùng tiền tệ, kỳ và trước/sau thuế với mức thấp nhất.</small></label></xpath>
    <xpath expr="//details[.//input[@name='salary_min']]" position="inside"><label class="tc-check"><input name="salary_negotiable" type="checkbox" t-att-checked="vals.get('salary_negotiable') == 'on'"/> Có thể thương lượng thu nhập</label></xpath>
    <xpath expr="//section[@id='profile-experience']/label[textarea[@name='work_history']]" position="before"><p class="tc-help">Các công việc cụ thể được thêm riêng ở phần “Quá trình làm việc” bên dưới. Phần này ghi tổng quan hoặc điều cần giải thích thêm; không tự cộng trùng thời gian.</p></xpath>
    <xpath expr="//section[@id='profile-education']" position="inside"><label>Trình độ học vấn chính<select name="education_level_id"><option value="">Chưa khai</option><option t-foreach="degree_options" t-as="d" t-att-value="d.id" t-att-selected="vals.get('education_level_id') == str(d.id)" t-esc="d.name"/></select><small>Quá trình học cụ thể có thể thêm nhiều mục bên dưới.</small></label></xpath>
    <xpath expr="//form[@action='/tuhoso/profile/save']" position="after"><section id="profile-experience-records" class="tc-card rp-records"><h2>Quá trình làm việc</h2><p>Ghi rõ vai trò, thời gian, trách nhiệm và kết quả của từng công việc. Người mới có thể ghi thực tập, làm thêm hoặc dự án thực hành.</p><t t-call="tacare_website.profile_timeline_list"><t t-set="timeline_kind" t-value="'experience'"/><t t-set="timeline_rows" t-value="profile.experience_ids"/><t t-set="can_edit_timeline" t-value="True"/></t></section><section id="profile-education-records" class="tc-card rp-records"><h2>Quá trình học tập</h2><p>Thêm trường, chuyên ngành, thời gian, bằng cấp và nội dung liên quan đến vị trí mong muốn.</p><t t-call="tacare_website.profile_timeline_list"><t t-set="timeline_kind" t-value="'education'"/><t t-set="timeline_rows" t-value="profile.education_ids"/><t t-set="can_edit_timeline" t-value="True"/></t></section></xpath>
    <xpath expr="//aside/nav/a[@href='#profile-experience']" position="after"><a href="#profile-experience-records">Quá trình làm việc</a><a href="#profile-education-records">Quá trình học tập</a></xpath>
    <xpath expr="//section[@id='profile-sharing']" position="attributes"><attribute name="t-if">edit and profile.user_id == request.env.user</attribute></xpath>
    <xpath expr="//aside/nav/a[@href='#profile-sharing']" position="attributes"><attribute name="t-if">profile.user_id == request.env.user</attribute></xpath>
    <xpath expr="//label[select[@name='visibility']]" position="attributes"><attribute name="t-if">profile.user_id == request.env.user</attribute></xpath>
  </template>

  <template id="profile_metadata_editor" name="Hồ sơ nhận việc · Chỉnh sửa nội dung chung"><t t-call="tacare_website.live_layout"><div class="pv-create"><a t-att-href="'/tuhoso/profile/%s' % profile.id">Trở về hồ sơ</a><h1>Chỉnh sửa hồ sơ nhận việc</h1><p>Các công việc và mức tiền công được chỉnh riêng trong từng mục nhận làm.</p><p t-if="profile.user_id != request.env.user" class="rp-admin-notice">Bạn đang chỉnh sửa hồ sơ của <t t-esc="profile.user_id.name"/>. Quyền chia sẻ thuộc chủ hồ sơ.</p><p t-if="error" role="alert" class="tc-error" t-esc="error"/><form action="/tuhoso/profile/save" method="post" class="tc-form tc-card"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="profile_id" t-att-value="profile.id"/><input type="hidden" name="profile_version" t-att-value="profile.version"/><label>Tên hồ sơ *<input name="profile_title" required="required" minlength="2" maxlength="160" t-att-value="vals.get('profile_title','')"/></label><label>Họ tên hiển thị *<input name="name" required="required" minlength="2" maxlength="160" t-att-value="vals.get('name','')"/></label><label>Giới thiệu ngắn<input name="headline" maxlength="180" t-att-value="vals.get('headline','')"/></label><label>Giới thiệu<textarea name="bio" rows="5"><t t-esc="vals.get('bio','')"/></textarea></label><label>Định hướng nhận việc<textarea name="goal" rows="3"><t t-esc="vals.get('goal','')"/></textarea></label><button class="tc-button" type="submit">Lưu hồ sơ</button></form></div></t></template>

  <template id="recruitment_create_details" inherit_id="tacare_website.profile_create" name="Tạo hồ sơ · Định hướng tuyển dụng">
    <xpath expr="//form/fieldset[1]" position="after"><fieldset data-recruitment-start="1"><legend>Thông tin tuyển dụng ban đầu</legend><p class="tc-help">Có thể ghi trước định hướng và thế mạnh. Sau khi tạo, bạn sẽ bổ sung từng công việc, quá trình học, kỹ năng và dự án. Hồ sơ mới được giữ riêng tư.</p><label>Vị trí / giới thiệu ngắn<input name="headline" maxlength="180" t-att-value="vals.get('headline','')" placeholder="Ví dụ: Frontend Junior · Giao diện web dễ sử dụng"/></label><div class="tc-form-grid"><label>Lĩnh vực mong muốn<select name="sector" data-create-sector="1"><option value="">Chưa chọn</option><option t-foreach="job_sectors" t-as="s" t-att-value="s.code" t-att-selected="vals.get('sector') == s.code" t-esc="s.name"/></select></label><label>Nhóm nghề mong muốn<select name="desired_position_id" data-create-position="1"><option value="">Chưa chọn</option><option t-foreach="positions" t-as="pos" t-att-value="pos.id" t-att-data-sector="pos.sector_id.code" t-att-selected="vals.get('desired_position_id') == str(pos.id)" t-esc="pos.name"/></select></label></div><label>Giới thiệu và thế mạnh<textarea name="bio" rows="4" maxlength="20000" placeholder="Hướng nghề nghiệp, điều bạn làm tốt và một trải nghiệm tiêu biểu."><t t-esc="vals.get('bio','')"/></textarea></label></fieldset></xpath>
    <xpath expr="//form" position="attributes"><attribute name="data-profile-create">1</attribute></xpath>
    <xpath expr="//h1" position="after"><p class="tc-eyebrow">BƯỚC 1 / CHỌN MỤC ĐÍCH VÀ ĐỊNH HƯỚNG</p></xpath>
  </template>
</odoo>
