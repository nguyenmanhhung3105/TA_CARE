<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="recruitment_profile_summary" name="Hồ sơ tuyển dụng · Nội dung chi tiết">
    <section class="pv-detail-grid rp-profile-summary"><div class="tc-stack">
      <section class="tc-card"><h2>Giới thiệu và định hướng</h2><p class="tc-prose" t-esc="profile.bio or 'Chưa bổ sung giới thiệu.'"/><t t-if="profile.goal"><h3>Mục tiêu nghề nghiệp</h3><p class="tc-prose" t-esc="profile.goal"/></t><a t-if="profile.portfolio_url" t-att-href="profile.portfolio_url" target="_blank" rel="noopener noreferrer">Xem portfolio / trang nghề nghiệp</a></section>
      <section class="tc-card"><h2>Kỹ năng</h2><div class="rp-skill-list"><article t-foreach="profile.skill_ids" t-as="skill"><h3 t-esc="skill.name"/><span class="tc-help" t-esc="dict(skill._fields['level'].selection).get(skill.level,'Chưa khai mức sử dụng')"/><p t-if="skill.use" t-esc="skill.use"/></article></div><p t-if="not profile.skill_ids">Chưa bổ sung kỹ năng.</p></section>
      <section class="tc-card"><h2>Quá trình làm việc</h2><t t-call="tacare_website.profile_timeline_list"><t t-set="timeline_kind" t-value="'experience'"/><t t-set="timeline_rows" t-value="profile.experience_ids"/><t t-set="can_edit_timeline" t-value="False"/></t><t t-if="profile.work_history"><h3>Tổng quan và thông tin bổ sung</h3><p class="tc-prose" t-esc="profile.work_history"/></t></section>
      <section class="tc-card"><h2>Học vấn và đào tạo</h2><t t-call="tacare_website.profile_timeline_list"><t t-set="timeline_kind" t-value="'education'"/><t t-set="timeline_rows" t-value="profile.education_ids"/><t t-set="can_edit_timeline" t-value="False"/></t><p t-if="profile.education_details or profile.education" class="tc-prose" t-esc="profile.education_details or profile.education"/></section>
      <section t-if="profile.languages" class="tc-card"><h2>Ngoại ngữ</h2><p class="tc-prose" t-esc="profile.languages"/></section><section t-if="profile.licenses" class="tc-card"><h2>Giấy phép và chứng chỉ</h2><p class="tc-prose" t-esc="profile.licenses"/></section>
      <section t-if="profile.evidence_ids" class="tc-card"><h2>Dự án và minh chứng</h2><article t-foreach="profile.evidence_ids" t-as="e" class="rp-timeline-row"><h3 t-esc="e.title"/><p><strong>Vai trò:</strong> <t t-esc="e.role"/></p><p class="tc-prose" t-esc="e.description"/><p t-if="e.result"><strong>Kết quả:</strong> <t t-esc="e.result"/></p><a t-if="e.url" t-att-href="e.url" target="_blank" rel="noopener noreferrer">Xem liên kết minh chứng</a><small class="tc-help" t-esc="dict(e._fields['status'].selection).get(e.status)"/></article></section>
    </div><aside class="tc-stack"><section class="tc-card"><h2>Công việc mong muốn</h2><dl class="fw-facts"><dt>Vị trí</dt><dd t-esc="profile.desired_position_id.name or profile.headline or 'Chưa chọn'"/><dt>Cấp độ</dt><dd t-esc="dict(profile._fields['career_level'].selection).get(profile.career_level,'Chưa khai')"/><dt>Loại cơ hội</dt><dd t-esc="dict(profile._fields['desired_type'].selection).get(profile.desired_type,'Chưa khai')"/><dt>Thời lượng</dt><dd t-esc="dict(profile._fields['work_fraction'].selection).get(profile.work_fraction,'Chưa khai')"/><dt>Cách làm</dt><dd t-esc="dict(modes).get(profile.mode,'Chưa chọn')"/><dt>Khu vực</dt><dd t-esc="profile.location or profile.region_id.name or 'Chưa khai'"/><dt>Kinh nghiệm liên quan</dt><dd t-esc="'%s tháng (tự khai)' % profile.relevant_months if profile.experience_known else 'Chưa xác định'"/><dt>Có thể bắt đầu</dt><dd t-esc="profile.start_date.strftime('%d/%m/%Y') if profile.start_date else 'Cần trao đổi'"/><dt>Chuyển nơi ở</dt><dd t-esc="dict(profile._fields['relocation'].selection).get(profile.relocation,'Chưa khai')"/><dt>Đi công tác</dt><dd t-esc="dict(profile._fields['travel'].selection).get(profile.travel,'Chưa khai')"/></dl></section>
      <section class="tc-card"><h2>Thu nhập mong muốn</h2><p class="rp-salary"><t t-if="profile.salary_min"><t t-esc="'{:,.0f}'.format(profile.salary_min).replace(',','.')"/><t t-if="profile.salary_max"> – <t t-esc="'{:,.0f}'.format(profile.salary_max).replace(',','.')"/></t> <t t-esc="profile.salary_currency_id.name"/> / <t t-esc="dict(profile._fields['salary_period'].selection).get(profile.salary_period,'kỳ chưa khai')"/></t><t t-else="">Cần trao đổi</t></p><p t-esc="dict(profile._fields['salary_tax'].selection).get(profile.salary_tax,'Chưa khai trước/sau thuế')"/><p t-esc="'Có thể thương lượng' if profile.salary_negotiable else 'Mức mong muốn theo phạm vi đã khai'"/></section>
      <section t-if="profile.preferred_conditions or profile.availability" class="tc-card"><h2>Lịch và điều kiện làm việc</h2><p t-if="profile.availability" class="tc-prose" t-esc="profile.availability"/><p t-if="profile.preferred_conditions" class="tc-prose" t-esc="profile.preferred_conditions"/></section><p class="tc-help">Thông tin do người tạo hồ sơ hoặc quản trị cập nhật. Kinh nghiệm, kỹ năng và minh chứng chưa được xem là đã xác minh.</p>
    </aside></section>
  </template>
  <template id="recruitment_overview_details" inherit_id="tacare_website.profile_overview" name="Hồ sơ · Hiển thị chi tiết tuyển dụng">
    <xpath expr="//section[hasclass('pv-detail-grid')]" position="replace"><t t-if="profile.care_recruitment_enabled" t-call="tacare_website.recruitment_profile_summary"/></xpath>
    <xpath expr="//div[hasclass('pv-library-heading')]/a" position="replace"><div class="tc-action-row"><a t-if="owner or role == 'admin'" class="tc-button" t-att-href="'/tuhoso/profile/%s/edit' % profile.id">Chỉnh sửa hồ sơ</a><a t-if="owner and not profile.care_recruitment_enabled" t-att-href="'/tuhoso/work/new?profile_id=%s' % profile.id">Thêm việc nhận làm</a></div></xpath>
  </template>
  <template id="profile_card_admin_edit" inherit_id="tacare_website.profile_card" name="Tủ · Chủ hồ sơ và admin chỉnh sửa">
    <xpath expr="//div[hasclass('pv-profile-bottom')]/a[contains(@t-att-href,'/tuhoso/me')]" position="replace"><a t-if="p.user_id == request.env.user or role == 'admin'" t-att-href="'/tuhoso/profile/%s/edit' % p.id">Chỉnh sửa</a></xpath>
  </template>
</odoo>
